# Copie para .env e preencha. O .env esta no .gitignore; nunca commite chaves.

# ---------------------------------------------------------------------------
# Conexao Postgres (usada por scripts/migrate.py, nao pela app Next.js)
#
# A conexao DIRETA (db.<ref>.supabase.co:5432) e IPv6 e nao funciona nesta rede.
# Use o Session pooler, que e IPv4 em todos os planos.
# Painel do Supabase > botao "Connect" > aba "Session pooler".
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.girfjqnbzsenucgbvojn:SENHA_AQUI@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Chaves da API do Supabase (usadas pela app Next.js)
# Painel do Supabase > Project Settings > API Keys.
# ---------------------------------------------------------------------------

# URL publica do projeto. Vai para o navegador.
NEXT_PUBLIC_SUPABASE_URL="https://girfjqnbzsenucgbvojn.supabase.co"

# Chave anon/publishable. Vai para o navegador; e protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY="COLE_A_CHAVE_ANON_AQUI"

# Chave service_role. IGNORA RLS e NUNCA pode ir para o navegador.
# Usada no servidor para ler o gabarito dos exercicios, corrigir respostas
# e autenticar a chamada da Edge Function do WordSound Insight.
SUPABASE_SERVICE_ROLE_KEY="COLE_A_CHAVE_SERVICE_ROLE_AQUI"

# ---------------------------------------------------------------------------
# WordSound Insight (camada de IA)
#
# "edge" e o padrao: a chave do fornecedor de IA NAO fica neste arquivo, e sim
# nos secrets da Edge Function do Supabase. Cadastre com:
#
#   npx supabase secrets set GOOGLE_API_KEY=...
#   npx supabase functions deploy explain-answer
#
# As alternativas chamam o fornecedor direto do servidor Next.js e ai sim
# exigem a chave aqui. Sem nada configurado o app funciona normalmente; so o
# botao "Entender melhor" avisa que o recurso nao esta disponivel.
# ---------------------------------------------------------------------------

# "edge" | "google" | "anthropic"
AI_PROVIDER="edge"

# So para AI_PROVIDER="google". Chave em https://aistudio.google.com/apikey
# GOOGLE_API_KEY="COLE_A_CHAVE_GOOGLE_AQUI"
# GOOGLE_MODEL="gemini-3.5-flash-lite"

# So para AI_PROVIDER="anthropic".
# ANTHROPIC_API_KEY="COLE_A_CHAVE_ANTHROPIC_AQUI"

# ---------------------------------------------------------------------------
# Token de acesso do Supabase (opcional)
#
# So e necessario para publicar e editar Edge Functions pela CLI. Gere em
# https://supabase.com/dashboard/account/tokens e revogue quando nao precisar.
# Atencao: o token vale para a conta inteira, nao so para este projeto.
# ---------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN="sbp_..."
